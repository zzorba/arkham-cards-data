      "input": {
        "type": "choose_one",
        "choices": [
          {
            "id": "defenses",
            "text": "We have to focus our defenses, no matter the stress.",
            "steps": [
              "maybe_swap_tablet_for_cultist"
            ]
          },
          {
            "id": "equipment",
            "text": "We have to stretch our equipment as thin as possible.",
            "steps": [
              "maybe_swap_cultist_for_tablet"
            ]
          }
        ]
      }
    },
